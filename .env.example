# LLM Provider API Keys
# 至少配置一個 LLM 提供商
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 嵌入模型配置
# 預設使用 BAAI/bge-small-zh-v1.5（中文優化，512 維，MIT 授權）
# 若需英文模型可改為 all-MiniLM-L6-v2（384 維）
# 注意：切換模型後舊的 embeddings.npy 與新模型不相容，需刪除重建
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
# retrieval 任務的 query prefix（bge 系列模型需要）
# 若切換為非 bge 模型，可設為空字串
EMBEDDING_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：

# 記憶系統配置
MEMORY_STORAGE_PATH=./data
MEMORY_MAX_EPISODES=10000
MEMORY_MAX_CONCEPTS=5000

# 檢索參數（預設值，會被神經化學狀態動態調整）
RETRIEVAL_SEED_K=5
RETRIEVAL_BREADTH_K=12
RETRIEVAL_WEIGHT_THRESHOLD=0.225

# 邊緣權重計算參數
EDGE_WEIGHT_ALPHA=0.3         # Recency 權重
EDGE_WEIGHT_BETA=0.4          # Frequency 權重
EDGE_WEIGHT_GAMMA=0.3         # Salience 權重
EDGE_RECENCY_LAMBDA=0.01      # 時間衰減率（per hour）

# 圖譜修剪閾值
PRUNING_MIN_WEIGHT=0.05       # < 0.05 直接刪除
PRUNING_COLD_STORAGE=0.15     # 0.05-0.15 冷儲存

# Dream Engine 配置
DREAM_ENABLED=true
DREAM_IDLE_MINUTES=30         # 閒置 N 分鐘後觸發
DREAM_CRON=0 3 * * *          # 每日凌晨 3 點觸發
DREAM_REPLAY_DA_THRESHOLD=0.6 # 重播多巴胺閾值

# 神經化學初始狀態
NEUROCHEM_DOPAMINE=0.5
NEUROCHEM_SEROTONIN=0.5

# 日誌配置
LOG_LEVEL=INFO
LOG_FILE=./data/echo_memory.log

# 開發模式
DEBUG=false
VERBOSE=false
