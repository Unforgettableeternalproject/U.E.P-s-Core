# ===== LLM Session Control 環境設定 =====

# --- 後端選擇 ---
# 可選: anthropic, openai, gemini, local
SESSION_CONTROL_BACKEND=anthropic

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_COMPACTION_MODEL=claude-haiku-4-5
# Server-side compaction (Beta)
ANTHROPIC_COMPACTION_ENABLED=false

# --- OpenAI ---
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_SUMMARY_MODEL=gpt-4o-mini

# --- Google Gemini / Vertex AI ---
GOOGLE_API_KEY=your-key-here
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash-lite

# --- 本地模型 (Qwen2.5) ---
LOCAL_MODEL_PATH=
LOCAL_MODEL_BACKEND=llama_cpp
# llama_cpp 或 vllm

# --- Token 計數 ---
# 預設 tokenizer，用於無法取得模型專用 tokenizer 時的 fallback
DEFAULT_TOKENIZER=cl100k_base

# --- 壓縮閾值 ---
# 佔 context window 的百分比
COMPRESSION_THRESHOLD_LAYER1=0.60
COMPRESSION_THRESHOLD_LAYER2=0.80
COMPRESSION_THRESHOLD_LAYER3=0.92

# --- Context Window 大小 ---
# 如果後端 API 無法自動偵測，手動設定
CONTEXT_WINDOW_SIZE=200000

# --- 人設保護 ---
# 人設上下文檔案路徑（YAML/JSON）
PERSONA_CONTEXT_PATH=

# --- Echo Memory 整合 ---
# Echo Memory MCP Server 位址（可選）
ECHO_MEMORY_ENDPOINT=
ECHO_MEMORY_NAMESPACE_ID=local-default

# --- 除錯 ---
SESSION_CONTROL_DEBUG=false
SESSION_CONTROL_LOG_LEVEL=INFO
