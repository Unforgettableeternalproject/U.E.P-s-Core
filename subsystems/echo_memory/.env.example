# LLM Provider API Keys
# 至少配置一個 LLM 提供商
GOOGLE_API_KEY=your_google_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Cloud Platform / Vertex AI（優先於 API Key）
# GCP_PROJECT_ID=your_gcp_project_id
# GCP_LOCATION=us-central1

# 嵌入模型配置
# 正式基準使用 U.E.P Core 主環境中的 Ollama bge-m3（1024 維、多語言）。
# 請先確認 `ollama list` 可看到 bge-m3；切換模型後會依
# embedding_index.json 自動完整重建索引，資料量大時首次啟動較慢。
EMBEDDING_MODEL=bge-m3
EMBEDDING_DEVICE=cpu
# bge-m3 不需要 retrieval query prefix。
EMBEDDING_QUERY_PREFIX=
# 本專案正式執行路徑使用 Ollama；sentence-transformers 僅保留為開發備援。
EMBEDDING_BACKEND=ollama
OLLAMA_BASE_URL=http://localhost:11434
# Ollama fallback 選填：未設就不帶。NUM_GPU 為整數（放進 options.num_gpu，0＝純 CPU）；
# KEEP_ALIVE 為 Ollama 時間字串（如 5m、1h）或整數秒（-1 常駐）。
# OLLAMA_FALLBACK_NUM_GPU=
# OLLAMA_FALLBACK_KEEP_ALIVE=

# 記憶系統配置
MEMORY_STORAGE_PATH=./data
# local-default 沿用 MEMORY_STORAGE_PATH；其他值隔離於 data/namespaces/<namespace_id>
# 允許英數開頭，後續可使用英數、底線、連字號，最長 64 字元
MEMORY_NAMESPACE_ID=local-default
MEMORY_MAX_EPISODES=10000
MEMORY_MAX_CONCEPTS=5000

# 檢索參數（預設值，會被神經化學狀態動態調整）
RETRIEVAL_SEED_K=5
RETRIEVAL_BREADTH_K=12
# bge-m3 分布偏高，0.25 無法過濾無關結果；0.35 為實測有效閾值。
RETRIEVAL_MIN_SIMILARITY=0.35
RETRIEVAL_WEIGHT_THRESHOLD=0.225

# 邊緣權重計算參數
EDGE_WEIGHT_ALPHA=0.3         # Recency 權重
EDGE_WEIGHT_BETA=0.4          # Frequency 權重
EDGE_WEIGHT_GAMMA=0.3         # Salience 權重
EDGE_RECENCY_LAMBDA=0.01      # 時間衰減率（每小時 /hour）
                              # 衰減公式：Recency = exp(-λ·hours)
                              # 範例（λ=0.01）：1hr≈0.990, 24hr≈0.787, 7天≈0.186
                              # 注意：所有時間運算統一使用「小時」為單位

# 圖譜修剪閾值
PRUNING_MIN_WEIGHT=0.05       # < 0.05 直接刪除
PRUNING_COLD_STORAGE=0.15     # 0.05-0.15 冷儲存

# Dream Engine 配置
DREAM_ENABLED=true
DREAM_IDLE_MINUTES=30         # 閒置 N 分鐘後觸發
DREAM_CRON=0 3 * * *          # 每日凌晨 3 點觸發
DREAM_ENABLE_IDLE=true        # 是否啟用閒置觸發
DREAM_ENABLE_CRON=true        # 是否啟用定時觸發
DREAM_MIN_PENDING=5           # idle 觸發需待做夢 episode >= N（0 = 不設門檻）
DREAM_DAYDREAM_PENDING=20     # 待做夢 >= N 即不等閒置觸發 daydream（0 = 停用）
DREAM_CRON_REQUIRE_PENDING=true # cron 需至少 1 個待做夢 episode；false = 每晚無條件跑
DREAM_REPLAY_DA_THRESHOLD=0.6 # 重播多巴胺閾值

# 神經化學初始狀態
NEUROCHEM_DOPAMINE=0.5
NEUROCHEM_SEROTONIN=0.5

# 日誌配置
LOG_LEVEL=INFO
LOG_FILE=./data/echo_memory.log

# 開發模式
DEBUG=false
VERBOSE=false
